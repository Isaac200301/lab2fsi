# Copie este archivo como .env y complete los valores. El archivo .env NO se sube al repositorio.

# Production URL del nodo Webhook de n8n (Paso 6 del laboratorio). También se puede pegar
# desde el propio chat con el botón de configuración.
VITE_N8N_WEBHOOK_URL=https://<nombre-dominio>.app.n8n.cloud/webhook/<id-path>

# Backend del Laboratorio 2 (Spring Boot + Drools). Solo se usa para crear reservas nuevas.
# En desarrollo no hace falta: Vite reenvía /airline al puerto 8080.
# VITE_API_URL=http://localhost:8080
