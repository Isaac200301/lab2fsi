        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"passenger\": {\n    \"name\": \"Carlos García\",\n    \"age\": 30,\n    \"membershipStatus\": \"Gold\",\n    \"seatPreference\": \"Window\",\n    \"travelingWithChildren\": false,\n    \"luggageWeight\": 12\n  },\n  \"flight\": {\n    \"flightNumber\": \"AV123\",\n    \"delayMinutes\": 90,\n    \"durationHours\": 3,\n    \"emergencyExitSeatAvailable\": false,\n    \"ticketPrice\": 500\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/airline/api/evaluate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "airline",
            "api",
            "evaluate"
          ]
        },
        "description": "Pasajero Gold con 90 minutos de retraso: asciende a clase ejecutiva."
      }
    },
